+#ifdef CONFIG_DARWIN
+/*
+ * macOS: a blob scanout that virglrenderer cannot hand over as a Metal texture (a Windows viogpu3d
+ * desktop rendered by the render server, whose resources live in shared memory) is shown as an
+ * ordinary 2D surface over that memory. The shared-memory fd is mapped read-only once per resource
+ * and unmapped when the guest releases the resource; resource flushes become 2D updates, so every
+ * 2D listener (VNC, and through it Tandem's window) sees the guest's frames.
+ */
+#include <sys/mman.h>
+
+typedef struct ShmScanoutMap {
+    void *ptr;
+    size_t size;
+} ShmScanoutMap;
+
+static GHashTable *shm_scanout_maps;          /* resource id -> ShmScanoutMap */
+static bool shm_scanout_active[VIRTIO_GPU_MAX_SCANOUTS];
+
+static void shm_scanout_map_free(gpointer data)
+{
+    ShmScanoutMap *m = data;
+
+    munmap(m->ptr, m->size);
+    g_free(m);
+}
+
+static void *shm_scanout_map(uint32_t resource_id, int fd, size_t size)
+{
+    ShmScanoutMap *m;
+    void *ptr;
+
+    if (!shm_scanout_maps) {
+        shm_scanout_maps = g_hash_table_new_full(NULL, NULL, NULL, shm_scanout_map_free);
+    }
+    m = g_hash_table_lookup(shm_scanout_maps, GUINT_TO_POINTER(resource_id));
+    if (m && m->size >= size) {
+        return m->ptr;
+    }
+    ptr = mmap(NULL, size, PROT_READ, MAP_SHARED, fd, 0);
+    if (ptr == MAP_FAILED) {
+        return NULL;
+    }
+    m = g_new0(ShmScanoutMap, 1);
+    m->ptr = ptr;
+    m->size = size;
+    g_hash_table_replace(shm_scanout_maps, GUINT_TO_POINTER(resource_id), m);
+    return ptr;
+}
+
+static void shm_scanout_unmap(uint32_t resource_id)
+{
+    if (shm_scanout_maps) {
+        g_hash_table_remove(shm_scanout_maps, GUINT_TO_POINTER(resource_id));
+    }
+}
+#endif
