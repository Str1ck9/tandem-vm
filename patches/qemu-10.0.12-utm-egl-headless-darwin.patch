 #include "ui/egl-context.h"
 #include "ui/shader.h"
 
+#ifdef CONFIG_DARWIN
+/*
+ * macOS has no DRI render node. With gl=core (the default) the GL work is done in Apple's OpenGL through
+ * CGL contexts that share objects with one readback context; with gl=es, ANGLE's EGL (on Metal) is used
+ * through the normal EGL path. Either way each finished frame is read back into the console surface, so
+ * 2D listeners such as VNC show the 3D output.
+ */
+#include <OpenGL/OpenGL.h>
+#include "system/system.h"
+
+static bool darwin_cgl;
+static CGLContextObj darwin_main_ctx;
+static CGLPixelFormatObj darwin_pixfmt;
+
+static CGLPixelFormatObj darwin_choose_pixel_format(void)
+{
+    CGLPixelFormatAttribute attribs[] = {
+        kCGLPFAOpenGLProfile, (CGLPixelFormatAttribute)kCGLOGLPVersion_GL4_Core,
+        kCGLPFAAccelerated,
+        kCGLPFAAllowOfflineRenderers,
+        0
+    };
+    CGLPixelFormatObj pix = NULL;
+    GLint npix = 0;
+
+    if (CGLChoosePixelFormat(attribs, &pix, &npix) != kCGLNoError || !pix) {
+        return NULL;
+    }
+    return pix;
+}
+
+/* GL work for the display runs in the readback context; the previous context is given back after. */
+#define DARWIN_ENTER()                                                        \
+    CGLContextObj darwin_prev = darwin_cgl ? CGLGetCurrentContext() : NULL;   \
+    if (darwin_cgl) {                                                         \
+        CGLSetCurrentContext(darwin_main_ctx);                                \
+    }
+#define DARWIN_LEAVE()                                                        \
+    if (darwin_cgl) {                                                         \
+        CGLSetCurrentContext(darwin_prev);                                    \
+    }
+#else
+#define DARWIN_ENTER()
+#define DARWIN_LEAVE()
+#endif
+
 typedef struct egl_dpy {
     DisplayChangeListener dcl;
     DisplaySurface *ds;
@@ -42,17 +88,54 @@
 static QEMUGLContext egl_create_context(DisplayGLCtx *dgc,
                                         QEMUGLParams *params)
 {
+#ifdef CONFIG_DARWIN
+    if (darwin_cgl) {
+        CGLContextObj ctx = NULL;
+
+        if (CGLCreateContext(darwin_pixfmt, darwin_main_ctx, &ctx) != kCGLNoError) {
+            error_report("egl-headless: CGLCreateContext failed");
+            return NULL;
+        }
+        return (QEMUGLContext)ctx;
+    }
+#endif
     eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
                    qemu_egl_rn_ctx);
     return qemu_egl_create_context(dgc, params);
 }
 
+static void egl_destroy_context(DisplayGLCtx *dgc, QEMUGLContext ctx)
+{
+#ifdef CONFIG_DARWIN
+    if (darwin_cgl) {
+        if (CGLGetCurrentContext() == (CGLContextObj)ctx) {
+            CGLSetCurrentContext(NULL);
+        }
+        CGLDestroyContext((CGLContextObj)ctx);
+        return;
+    }
+#endif
+    qemu_egl_destroy_context(dgc, ctx);
+}
+
+static int egl_make_context_current(DisplayGLCtx *dgc, QEMUGLContext ctx)
+{
+#ifdef CONFIG_DARWIN
+    if (darwin_cgl) {
+        return CGLSetCurrentContext((CGLContextObj)ctx) == kCGLNoError ? 0 : -1;
+    }
+#endif
+    return qemu_egl_make_context_current(dgc, ctx);
+}
+
 static void egl_scanout_disable(DisplayChangeListener *dcl)
 {
     egl_dpy *edpy = container_of(dcl, egl_dpy, dcl);
 
+    DARWIN_ENTER();
     egl_fb_destroy(&edpy->guest_fb);
     egl_fb_destroy(&edpy->blit_fb);
+    DARWIN_LEAVE();
 }
 
